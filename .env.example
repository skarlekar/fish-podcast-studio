# Copy this file to ".env" and fill in your keys. ".env" is git-ignored.
# Leave a key blank and Podcast Studio will ask for it in the browser when it launches.

# Claude (script writing) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Fish Audio (voicing) — https://fish.audio/go-api/
FISH_AUDIO_API_KEY=

# Optional
# PORT=3000
# FISH_MODEL=s2.1-pro-free     # default audio engine: s2.1-pro-free | s2.1-pro | s2-pro | drama-3 | s1
# CLAUDE_MODEL=claude-sonnet-5-5
